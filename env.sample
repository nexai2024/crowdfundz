# Copy this file to .env.local for local development, or set the same
# names in the Vercel project for production. Replace every sample value.
# Do not commit .env.local. This file is safe to commit because the values are fake.
#
# .gitignore ignores names that start with .env, so this file is named env.sample.

# ---------------------------------------------------------------------------
# Database
# Runtime queries use the pooled URL. Prisma migrations prefer a direct URL
# when DIRECT_URL is set, and otherwise fall back to DATABASE_URL.
# ---------------------------------------------------------------------------

# Pooled Postgres connection used by the Next.js app.
# Sample shape for Prisma Postgres. Use the pooled host, not a local guess.
DATABASE_URL="postgresql://user:password@pooled.db.example.com:5432/postgres?sslmode=require"

# Direct Postgres connection used by `npx prisma migrate deploy`.
# Omit only if DATABASE_URL is already a direct connection.
DIRECT_URL="postgresql://user:password@db.example.com:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Auth
# Better Auth signs session cookies with BETTER_AUTH_SECRET.
# BETTER_AUTH_URL must include https:// in production. A bare host is rewritten
# to http://, which breaks cookies and reset links on the live site.
# ---------------------------------------------------------------------------

# At least 32 random bytes, base64. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Public origin of the apex site. No trailing slash.
BETTER_AUTH_URL="https://crowdventure.quest"

# Optional Better Auth dashboard / abuse-protection project.
# dash() is enabled. Leave these unset if you are not using that hosted project.
# The client sentinel plugin will warn until an ingestion URL is configured.
BETTER_AUTH_API_KEY="ba_live_replace_me"
BETTER_AUTH_API_URL="https://api.better-auth.com"
BETTER_AUTH_KV_URL="https://kv.better-auth.com/projects/your-project-id"

# ---------------------------------------------------------------------------
# Stripe
# Checkout and Connect stay off until STRIPE_SECRET_KEY is set.
# A creator still cannot be paid until they finish Connect onboarding.
# Use sk_test_ / whsec_ from a test webhook locally. Use sk_live_ in production.
# ---------------------------------------------------------------------------

# Secret key from the Stripe dashboard. Server only.
STRIPE_SECRET_KEY="sk_test_replace_me"

# Signing secret from the webhook endpoint that points at /api/webhook.
# Subscribe to: checkout.session.completed, charge.updated, charge.refunded,
# charge.dispute.created, charge.dispute.closed.
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Comma-separated operator emails that can open /account/reconcile for every studio.
# Creators can still reconcile their own subdomain from /account without being listed here.
PLATFORM_ADMIN_EMAILS="operator@example.com"

# Fallback origin for Checkout success and cancel URLs when the browser
# origin is missing. Must be an allowed apex: crowdventure.quest or venturesolo.quest.
NEXT_PUBLIC_APP_URL="https://crowdventure.quest"

# ---------------------------------------------------------------------------
# Email
# Password reset and the studio "send confirmation" button use Resend.
# Stripe sends the payment receipt itself when receipt_email is set on the charge.
# Both keys are required together. If either is empty, reset mail does not send.
# ---------------------------------------------------------------------------

# Resend API key. Server only.
RESEND_API_KEY="re_replace_me"

# Verified sender in Resend. Must be an address on a domain you have verified.
EMAIL_FROM="Crowdventure <pledge@crowdventure.quest>"

# ---------------------------------------------------------------------------
# GitHub
# Used when a creator checks whether a milestone pull request has merged.
# Public pull requests can be checked with no token. A token raises the rate
# limit and can read private repositories the token can access.
# ---------------------------------------------------------------------------

GITHUB_TOKEN="github_pat_replace_me"
