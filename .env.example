# Next.js specific environment variables
NEXT_PUBLIC_API_URL="https://localhost:3000/api"

# Node environment
NODE_ENV="development"

# Connect to Supabase via connection pooling with Supavisor.
DATABASE_URL="postgresql://postgres.[projectname]:[password]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations.
DIRECT_URL="postgresql://postgres.[projectname]:[password]@aws-0-us-west-1.pooler.supabase.com:5432/postgres"

# Supabase public URL and anon key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Beta intake. Set to "enabled" to close self-serve signup and send / to the waitlist.
# Any other value, including unset, leaves normal signup open. Restart the server after changing it.
BETA_GATE=disabled

# Comma-separated emails that can open /admin/waitlist.
PLATFORM_ADMIN_EMAILS=

# Inbox for a heads-up on each new waitlist entry. Falls back to the first PLATFORM_ADMIN_EMAILS address.
WAITLIST_NOTIFY_EMAIL=

# Transactional email via Resend. Required for waitlist confirmation and studio invites.
RESEND_API_KEY=
EMAIL_FROM=