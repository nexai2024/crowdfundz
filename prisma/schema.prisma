datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                     String     @id @default(cuid())
  email                  String     @unique
  name                   String?
  subdomain              String     @unique
  headline               String?
  bio                    String?    @db.Text
  stripeConnectAccountId String?
  campaigns              Campaign[]
  createdAt              DateTime   @default(now())
}

model Campaign {
  id              String         @id @default(cuid())
  slug            String
  title           String
  tagline         String
  story           String         @db.Text
  eyebrow         String?
  statusLabel     String?
  manifestoTitle  String?
  manifestoQuote  String?
  endsAt          DateTime?
  targetGoal      Int
  totalRaised     Int            @default(0)
  backerCount     Int            @default(0)
  status          CampaignStatus @default(ACTIVE)
  creatorId       String
  creator         User           @relation(fields: [creatorId], references: [id])
  tiers           Tier[]
  backers         Backer[]
  phases          Phase[]
  faqs            Faq[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([creatorId, slug])
  @@index([creatorId])
}

model Phase {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  label       String
  title       String
  description String   @db.Text
  sortOrder   Int      @default(0)

  @@index([campaignId])
}

model Faq {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  question   String
  answer     String   @db.Text
  sortOrder  Int      @default(0)

  @@index([campaignId])
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  PAUSED
}

model Tier {
  id          String    @id @default(cuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name        String
  priceUsd    Int
  description String
  perks       String[]
  badge       String?
  featured    Boolean   @default(false)
  limit       Int?
  backers     Backer[]
  sortOrder   Int       @default(0)

  @@index([campaignId])
}

model Backer {
  id              String        @id @default(cuid())
  campaignId      String
  campaign        Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tierId          String
  tier            Tier          @relation(fields: [tierId], references: [id])
  email           String
  name            String
  handle          String?
  message         String?       @db.VarChar(120)
  amountUsd       Int
  status          PaymentStatus @default(PENDING)
  stripeSessionId String?       @unique
  backerNumber    Int           @default(autoincrement())
  createdAt       DateTime      @default(now())

  @@index([campaignId])
  @@index([tierId])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}