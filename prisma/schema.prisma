
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                     String        @id @default(cuid())
  email                  String        @unique
  name                   String?
  emailVerified          Boolean       @default(false)
  image                  String?
  subdomain              String?       @unique
  headline               String?
  bio                    String?       @db.Text
  stripeConnectAccountId String?
  campaigns              Campaign[]
  sessions               Session[]
  accounts               Account[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  devtoolsuser           DevtoolsUser?
  memberships            CommunityMembership[]
  communityComments      CommunityComment[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Campaign {
  id               String              @id @default(cuid())
  slug             String
  title            String
  tagline          String
  story            String              @db.Text
  eyebrow          String?
  statusLabel      String?
  manifestoTitle   String?
  manifestoQuote   String?
  endsAt           DateTime?
  targetGoal       Int
  totalRaised      Int                 @default(0)
  backerCount      Int                 @default(0)
  status           CampaignStatus      @default(ACTIVE)
  repoUrl          String?
  repoBranch       String?             @default("main")
  ideEditor        String?
  vercelProjectUrl String?
  productionUrl    String?
  previewUrl       String?
  creatorId        String
  creator          User                @relation(fields: [creatorId], references: [id])
  tiers            Tier[]
  tasks            Task[]
  backers          Backer[]
  phases           Phase[]
  faqs             Faq[]
  metrics          BuildMetric[]
  ideUpdates       IdeUpdate[]
  sandboxes        DemoSandbox[]
  polls            GovernancePoll[]
  bounties         Bounty[]
  compliance       ComplianceCheck?
  sponsors         SponsorSlot[]
  collaborations   CollaborationLoop[]
  paywalls         MilestonePaywall[]
  subcommunity     Subcommunity?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([creatorId, slug])
  @@index([creatorId])
}

model BuildMetric {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  pageViews    Int      @default(0)
  uniqueUsers  Int      @default(0)
  commitsCount Int      @default(0)
  weeklyGrowth Float    @default(0.0)
  recordedAt   DateTime @default(now())

  @@index([campaignId])
}

model IdeApiKey {
  id        String   @id @default(cuid())
  userId    String
  key       String   @unique
  name      String   @default("VSCode Extension")
  createdAt DateTime @default(now())
}

model IdeUpdate {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  editor        String   @default("VS Code")
  commitHash    String?
  commitMessage String
  linesAdded    Int      @default(0)
  linesDeleted  Int      @default(0)
  fileChanged   String?
  createdAt     DateTime @default(now())

  @@index([campaignId])
}

model DemoSandbox {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title       String
  sandboxUrl  String
  embedCode   String?  @db.Text
  environment String   @default("Node.js / React")
  status      String   @default("RUNNING")
  createdAt   DateTime @default(now())

  @@index([campaignId])
}

model GovernancePoll {
  id          String           @id @default(cuid())
  campaignId  String
  campaign    Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title       String
  description String           @db.Text
  options     String[]
  status      String           @default("OPEN")
  expiresAt   DateTime?
  votes       GovernanceVote[]
  createdAt   DateTime         @default(now())

  @@index([campaignId])
}

model GovernanceVote {
  id          String         @id @default(cuid())
  pollId      String
  poll        GovernancePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  backerEmail String
  optionIndex Int
  weight      Int            @default(1)
  createdAt   DateTime       @default(now())

  @@unique([pollId, backerEmail])
  @@index([pollId])
}

model Bounty {
  id          String             @id @default(cuid())
  campaignId  String
  campaign    Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title       String
  description String             @db.Text
  rewardUsd   Int
  status      String             @default("OPEN")
  submissions BountySubmission[]
  createdAt   DateTime           @default(now())

  @@index([campaignId])
}

model BountySubmission {
  id               String   @id @default(cuid())
  bountyId         String
  bounty           Bounty   @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  contributorName  String
  contributorEmail String
  submissionUrl    String
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())

  @@index([bountyId])
}

model ComplianceCheck {
  id                 String   @id @default(cuid())
  campaignId         String   @unique
  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  disclaimerVerified Boolean  @default(false)
  kycStatus          String   @default("UNVERIFIED")
  jurisdiction       String   @default("UNSET")
  taxFormFiled       Boolean  @default(false)
  lastAuditedAt      DateTime @default(now())
}

model SponsorSlot {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sponsorName   String
  logoUrl       String
  websiteUrl    String
  tierName      String   @default("Gold Sponsor")
  amountPaidUsd Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([campaignId])
}

model CollaborationLoop {
  id                 String   @id @default(cuid())
  campaignId         String
  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  partnerSubdomain   String
  partnerSlug        String
  partnerTitle       String
  discountPercentage Int      @default(10)
  createdAt          DateTime @default(now())

  @@index([campaignId])
}

model MilestonePaywall {
  id                String   @id @default(cuid())
  campaignId        String
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title             String
  description       String   @db.Text
  requiredRaisedUsd Int
  contentUrl        String
  locked            Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@index([campaignId])
}

model Phase {
  id                  String             @id @default(cuid())
  campaignId          String
  campaign            Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  label               String
  title               String
  description         String             @db.Text
  sortOrder           Int                @default(0)
  pullRequestUrl      String?
  pullRequestMergedAt DateTime?
  tasks               Task[]
  allocations         PledgeAllocation[]

  @@index([campaignId])
}

model Task {
  id         String     @id @default(cuid())
  campaignId String
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phaseId    String?
  phase      Phase?     @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  title      String
  details    String     @default("") @db.Text
  status     TaskStatus @default(TODO)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([campaignId])
  @@index([phaseId])
}

enum TaskStatus {
  TODO
  DOING
  DONE
}

model Faq {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  question   String
  answer     String   @db.Text
  sortOrder  Int      @default(0)

  @@index([campaignId])
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  PAUSED
}

model Tier {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name        String
  priceUsd    Int
  description String
  perks       String[]
  badge       String?
  featured    Boolean  @default(false)
  limit       Int?
  backers     Backer[]
  sortOrder   Int      @default(0)

  @@index([campaignId])
}

model Backer {
  id                    String             @id @default(cuid())
  campaignId            String
  campaign              Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tierId                String
  tier                  Tier               @relation(fields: [tierId], references: [id])
  email                 String
  name                  String
  handle                String?
  message               String?            @db.VarChar(120)
  amountUsd             Int
  status                PaymentStatus      @default(PENDING)
  stripeSessionId       String?            @unique
  stripePaymentIntentId String?            @unique
  stripeChargeId        String?            @unique
  stripeFeeCents        Int?
  stripeTransferId      String?            @unique
  fundingMode           FundingMode        @default(INSTANT)
  entitledAt            DateTime?
  backerNumber          Int                @default(autoincrement())
  createdAt             DateTime           @default(now())
  allocations           PledgeAllocation[]

  @@index([campaignId])
  @@index([tierId])
}

model PledgeAllocation {
  id               String           @id @default(cuid())
  backerId         String
  backer           Backer           @relation(fields: [backerId], references: [id], onDelete: Cascade)
  phaseId          String
  phase            Phase            @relation(fields: [phaseId], references: [id], onDelete: Restrict)
  amountUsd        Int
  cardFeeCents     Int?
  status           AllocationStatus @default(PENDING)
  signedOffAt      DateTime?
  releasedAt       DateTime?
  stripeTransferId String?          @unique
  createdAt        DateTime         @default(now())

  @@unique([backerId, phaseId])
  @@index([phaseId])
  @@index([backerId])
}

enum FundingMode {
  INSTANT
  MILESTONE
}

enum AllocationStatus {
  PENDING
  HELD
  RELEASING
  RELEASED
  REFUNDED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  DISPUTED
}

enum WaitlistStatus {
  pending
  approved
  rejected
  promoted
}

model WaitlistEntry {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  message         String?        @db.Text
  status          WaitlistStatus @default(pending)
  source          String         @default("waitlist")
  createdAt       DateTime       @default(now()) @map("created_at")
  statusChangedAt DateTime       @default(now()) @map("status_changed_at")

  @@index([status, createdAt], map: "waitlist_status_created_at_idx")
  @@map("waitlist")
}

model DevtoolsUser {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateKey String
  label       String
  email       String
  createdAt   DateTime
  updatedAt   DateTime

  @@unique([userId])
  @@unique([email])
  @@map("devtoolsUser")
}

enum RescueRole {
  backer
  maker
}

model RescueOptIn {
  id        String     @id @default(cuid())
  name      String
  email     String
  role      RescueRole
  project   String?
  message   String?    @db.Text
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([email])
  @@map("rescue_opt_in")
}

model Community {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  description    String         @db.Text
  createdAt      DateTime       @default(now())
  subcommunities Subcommunity[]
}

model Subcommunity {
  id          String                @id @default(cuid())
  communityId String
  community   Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  campaignId  String                @unique
  campaign    Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdAt   DateTime              @default(now())
  members     CommunityMembership[]
  comments    CommunityComment[]

  @@index([communityId])
}

model CommunityMembership {
  id             String       @id @default(cuid())
  subcommunityId String
  subcommunity   Subcommunity @relation(fields: [subcommunityId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([subcommunityId, userId])
  @@index([userId])
}

model CommunityComment {
  id             String       @id @default(cuid())
  subcommunityId String
  subcommunity   Subcommunity @relation(fields: [subcommunityId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  body           String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([subcommunityId, createdAt])
}
